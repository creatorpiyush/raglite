{
  "name": "raglite-toolkit",
  "version": "2.2.0",
  "description": "Build semantic search, multi-provider question answering, and REST APIs over your documents in a few lines of TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "raglite": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"import('node:fs').then(({chmodSync}) => chmodSync('dist/cli.js', 0o755))\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "smoke:providers": "tsx scripts/smoke-providers.ts",
    "example:basic": "tsx examples/basic.ts",
    "example:serve": "tsx examples/serve.ts",
    "example:multi": "tsx examples/multi-provider.ts",
    "example:lancedb": "tsx examples/lancedb-example.ts",
    "example:qdrant": "tsx examples/qdrant-example.ts",
    "example:collection": "tsx examples/collection-demo.ts",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "semantic-search",
    "embeddings",
    "vector-search",
    "vector-database",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "mistral",
    "cohere",
    "groq",
    "ollama",
    "typescript",
    "hono",
    "ai",
    "chatbot",
    "question-answering",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Piyush Anand",
  "license": "MIT",
  "homepage": "https://creatorpiyush.github.io/raglite/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatorpiyush/raglite.git"
  },
  "bugs": {
    "url": "https://github.com/creatorpiyush/raglite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.9",
    "ai": "^7.0.28",
    "hono": "^4.12.30",
    "mammoth": "^1.12.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.15",
    "@ai-sdk/cohere": "^4.0.10",
    "@ai-sdk/google": "^4.0.16",
    "@ai-sdk/groq": "^4.0.11",
    "@ai-sdk/mistral": "^4.0.11",
    "@ai-sdk/openai": "^4.0.14",
    "@ai-sdk/xai": "^4.0.13",
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "voyage-ai-provider": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/cohere": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/groq": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "@lancedb/lancedb": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "ollama-ai-provider-v2": {
      "optional": true
    },
    "voyage-ai-provider": {
      "optional": true
    }
  },
  "overrides": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.15",
    "@ai-sdk/cohere": "^4.0.10",
    "@ai-sdk/google": "^4.0.16",
    "@ai-sdk/groq": "^4.0.11",
    "@ai-sdk/mistral": "^4.0.11",
    "@ai-sdk/openai": "^4.0.14",
    "@ai-sdk/xai": "^4.0.13",
    "@biomejs/biome": "^2.5.4",
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ollama-ai-provider-v2": "^4.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "voyage-ai-provider": "^4.0.0"
  }
}
